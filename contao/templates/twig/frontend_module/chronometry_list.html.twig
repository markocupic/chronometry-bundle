{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    {% add to head %}
        <script src="assets/contao-component-bootstrap/bootstrap/dist/js/bootstrap.min.js"></script>
        <link rel="stylesheet" href="assets/contao-component-bootstrap/bootstrap/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="{{ asset('styles.css', 'markocupic_chronometry') }}">
        <link rel="stylesheet" href="assets/contao-component-fontawesome-free/fontawesomefree/js-packages/@fortawesome/fontawesome-free/css/all.css">
        <link rel="stylesheet" href="assets/contao-component-fontawesome-free/fontawesomefree/js-packages/@fortawesome/fontawesome-free/css/brands.css">
    {% endadd %}
    <div id="chronometry-app">
        <loading-spinner></loading-spinner>
        <div class="application">
            <div id="toggleSidebar">
                <button type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarContainer" aria-controls="sidebarContainer">
                    <i class="sidebar-toggle-icon fa-solid fa-4x fa-bars"></i>
                </button>
            </div>
            <sidebar></sidebar>
            <div class="container">
                <online-status-indicator></online-status-indicator>
                <runners-table></runners-table>
            </div>
            <modal></modal>
        </div>
    </div><
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        CHRONOMETRY = {
            requestToken: '{{ request_token }}',
            modalId: 'chronometryModal',
        }
    </script>
    {% add to body %}
        <script src="{{ asset('app.js','markocupic_chronometry') }}"></script>
    {% endadd %}
{% endblock %}
